   "id": "ev131_1928",
   "kind": "msg",
   "ptrs": [
    "0x4010"
   ],
   "speaker": "アデノイド",
   "jp": "　問題とは？\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1944",
   "kind": "msg",
   "ptrs": [
    "0x4024"
   ],
   "speaker": "ルジェロ",
   "jp": "　実は構造上\n　たいへん大きく、しかも重いのです。\n\n",
