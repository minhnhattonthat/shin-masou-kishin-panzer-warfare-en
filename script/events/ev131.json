 "lines": [
  {
   "id": "ev131_0890",
   "kind": "msg",
   "ptrs": [
    "0x37C8"
   ],
   "speaker": "",
   "jp": "　ナトゥーレ王国\n　　王都\n\n",
   "en": ""
  },
  {
   "id": "ev131_08B0",
   "kind": "msg",
   "ptrs": [
    "0x3804"
   ],
   "speaker": "シャーナ",
   "jp": "　ロセリニ様。\n　ご無事でなによりでした。\n\n",
   "en": ""
  },
  {
   "id": "ev131_08E8",
   "kind": "msg",
   "ptrs": [
    "0x3818"
   ],
   "speaker": "ロセリニ",
   "jp": "　ご心配をおかけしました。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0910",
   "kind": "msg",
   "ptrs": [
    "0x382C"
   ],
   "speaker": "ロセリニ",
   "jp": "　ここにこうしていられるのも\n　シャーナ様及びナトゥーレ王国の\n　ご協力があってのもの。\n",
   "en": ""
  },
  {
   "id": "ev131_0974",
   "kind": "msg",
   "ptrs": [
    "0x3840"
   ],
   "speaker": "ロセリニ",
   "jp": "　本当にありがとうございました。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_09A4",
   "kind": "msg",
   "ptrs": [
    "0x3854"
   ],
   "speaker": "シャーナ",
   "jp": "　いいえ。\n　私はなにもしておりません。\n\n",
   "en": ""
  },
  {
   "id": "ev131_09D8",
   "kind": "msg",
   "ptrs": [
    "0x3868"
   ],
   "speaker": "シャーナ",
   "jp": "　これはそちらにいらっしゃる\n　ベウマー殿らのお力です。\n\n",
   "en": ""
  },
  {
   "id": "ev131_0A1C",
   "kind": "msg",
   "ptrs": [
    "0x387C"
   ],
   "speaker": "シャーナ",
   "jp": "　よい部下をお持ちですね。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0A44",
   "kind": "msg",
   "ptrs": [
    "0x3890"
   ],
   "speaker": "ベウマー",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0A64",
   "kind": "msg",
   "ptrs": [
    "0x38A4"
   ],
   "speaker": "ロセリニ",
   "jp": "　いいえ、シャーナ様。\n　彼らは部下でありません。\n\n",
   "en": ""
  },
  {
   "id": "ev131_0AA4",
   "kind": "msg",
   "ptrs": [
    "0x38B8"
   ],
   "speaker": "ロセリニ",
   "jp": "　私の仲間です。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0AC4",
   "kind": "msg",
   "ptrs": [
    "0x38CC"
   ],
   "speaker": "シャーナ",
   "jp": "　仲間？\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0ADC",
   "kind": "msg",
   "ptrs": [
    "0x38E0"
   ],
   "speaker": "ロセリニ",
   "jp": "　はい。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0AF4",
   "kind": "msg",
   "ptrs": [
    "0x38F4"
   ],
   "speaker": "ロセリニ",
   "jp": "　バルツフィーム解放軍は王都解放後、\n　新たにバルツフィーム共和国として\n　国を再建するつもりです。\n",
   "en": ""
  },
  {
   "id": "ev131_0B64",
   "kind": "msg",
   "ptrs": [
    "0x3908"
   ],
   "speaker": "ロセリニ",
   "jp": "　もちろん、このことは\n　現在、唯一の王位継承権を持つ\n　アルマ様もお望みのこと。\n",
   "en": ""
  },
  {
   "id": "ev131_0BC0",
   "kind": "msg",
   "ptrs": [
    "0x391C"
   ],
   "speaker": "シャーナ",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0BE0",
   "kind": "msg",
   "ptrs": [
    "0x3930"
   ],
   "speaker": "シャーナ",
   "jp": "　そうですか……アルマ、\n　いえアルマ様は、やはり……。\n\n",
   "en": ""
  },
  {
   "id": "ev131_0C24",
   "kind": "msg",
   "ptrs": [
    "0x3944"
   ],
   "speaker": "ロセリニ",
   "jp": "　……やはりと申しますと？\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0C4C",
   "kind": "msg",
   "ptrs": [
    "0x3958"
   ],
   "speaker": "シャーナ",
   "jp": "　詳しくは\n　私たちの個人的な話ゆえ\n　申し上げられません。\n",
   "en": ""
  },
  {
   "id": "ev131_0C94",
   "kind": "msg",
   "ptrs": [
    "0x396C"
   ],
   "speaker": "シャーナ",
   "jp": "　ただ、ここに滞在しているときに\n　そのようなことを\n　おっしゃられていたものですから。\n",
   "en": ""
  },
  {
   "id": "ev131_0CF8",
   "kind": "msg",
   "ptrs": [
    "0x3980"
   ],
   "speaker": "ロセリニ",
   "jp": "　なるほど。\n　そのころから\n　決意をされていたということですな。\n",
   "en": ""
  },
  {
   "id": "ev131_0D44",
   "kind": "msg",
   "ptrs": [
    "0x3994"
   ],
   "speaker": "シャーナ",
   "jp": "　……そう思います。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0D68",
   "kind": "msg",
   "ptrs": [
    "0x39A8"
   ],
   "speaker": "ロセリニ",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0D88",
   "kind": "msg",
   "ptrs": [
    "0x39E4"
   ],
   "speaker": "シャーナ",
   "jp": "　………………？\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0DA8",
   "kind": "msg",
   "ptrs": [
    "0x39F8"
   ],
   "speaker": "ロセリニ",
   "jp": "　……いや、失礼いたしました。\n　少々、思うことがありまして。\n\n",
   "en": ""
  },
  {
   "id": "ev131_0DF4",
   "kind": "msg",
   "ptrs": [
    "0x3A0C"
   ],
   "speaker": "ロセリニ",
   "jp": "　お話を続けさせて\n　よろしいですかな？\n\n",
   "en": ""
  },
  {
   "id": "ev131_0E28",
   "kind": "msg",
   "ptrs": [
    "0x3A48"
   ],
   "speaker": "シャーナ",
   "jp": "　どうぞ。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0E40",
   "kind": "msg",
   "ptrs": [
    "0x3A5C"
   ],
   "speaker": "ロセリニ",
   "jp": "　……我々は、\n　今回の戦争で様々なことを\n　学びました。\n",
   "en": ""
  },
  {
   "id": "ev131_0E84",
   "kind": "msg",
   "ptrs": [
    "0x3A70"
   ],
   "speaker": "ロセリニ",
   "jp": "　今後はよりよい国にするべく\n　様々な改革を考えております。\n\n",
   "en": ""
  },
  {
   "id": "ev131_0ECC",
   "kind": "msg",
   "ptrs": [
    "0x3A84"
   ],
   "speaker": "シャーナ",
   "jp": "　そうですか。\n　それは楽しみなことですね。\n\n",
   "en": ""
  },
  {
   "id": "ev131_0F04",
   "kind": "msg",
   "ptrs": [
    "0x3A98"
   ],
   "speaker": "ロセリニ",
   "jp": "　はい。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0F1C",
   "kind": "msg",
   "ptrs": [
    "0x3AAC"
   ],
   "speaker": "ロセリニ",
   "jp": "　ただ、国の構造が変わっても\n　ナトゥーレ王国と協力関係は\n　継続していきたいと思っています。\n",
   "en": ""
  },
  {
   "id": "ev131_0F84",
   "kind": "msg",
   "ptrs": [
    "0x3AC0"
   ],
   "speaker": "ロセリニ",
   "jp": "　その点に関しては\n　ぜひともご理解をいただきたい。\n\n",
   "en": ""
  },
  {
   "id": "ev131_0FC4",
   "kind": "msg",
   "ptrs": [
    "0x3AD4"
   ],
   "speaker": "シャーナ",
   "jp": "　もちろんです。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_0FE4",
   "kind": "msg",
   "ptrs": [
    "0x3AE8"
   ],
   "speaker": "シャーナ",
   "jp": "　私たちは\n　ア・ゼルスの平和という\n　目標があるのですから。\n",
   "en": ""
  },
  {
   "id": "ev131_102C",
   "kind": "msg",
   "ptrs": [
    "0x3AFC"
   ],
   "speaker": "ロセリニ",
   "jp": "　ありがたきお言葉。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1050",
   "kind": "msg",
   "ptrs": [
    "0x3B10"
   ],
   "speaker": "ロセリニ",
   "jp": "　今後とも\n　よろしくお願いいたします。\n\n",
   "en": ""
  },
  {
   "id": "ev131_1084",
   "kind": "msg",
   "ptrs": [
    "0x3B24"
   ],
   "speaker": "シャーナ",
   "jp": "　いいえ。\n　こちらこそ。\n\n",
   "en": ""
  },
  {
   "id": "ev131_10AC",
   "kind": "msg",
   "ptrs": [
    "0x3B38"
   ],
   "speaker": "ロセリニ",
   "jp": "　シャーナ様。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_10C8",
   "kind": "msg",
   "ptrs": [
    "0x3B4C"
   ],
   "speaker": "ロセリニ",
   "jp": "　実は、それともう一つ\n　お願いがあるのです。\n\n",
   "en": ""
  },
  {
   "id": "ev131_1104",
   "kind": "msg",
   "ptrs": [
    "0x3B60"
   ],
   "speaker": "シャーナ",
   "jp": "　お願いと申しますと？\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1128",
   "kind": "msg",
   "ptrs": [
    "0x3B74"
   ],
   "speaker": "ロセリニ",
   "jp": "　魔装機神と\n　その操者に関してです。\n\n",
   "en": ""
  },
  {
   "id": "ev131_115C",
   "kind": "msg",
   "ptrs": [
    "0x3B88"
   ],
   "speaker": "ロセリニ",
   "jp": "　現在、イェン殿を含め\n　バルツフィーム解放軍のもと、\n　ともに戦っております。\n",
   "en": ""
  },
  {
   "id": "ev131_11B8",
   "kind": "msg",
   "ptrs": [
    "0x3B9C"
   ],
   "speaker": "ロセリニ",
   "jp": "　彼らの活躍のおかげで\n　現在の我々があるといっても\n　過言ではありません。\n",
   "en": ""
  },
  {
   "id": "ev131_1210",
   "kind": "msg",
   "ptrs": [
    "0x3BB0"
   ],
   "speaker": "ロセリニ",
   "jp": "　それだけ魔装機神の力は\n　強大です。\n\n",
   "en": ""
  },
  {
   "id": "ev131_1244",
   "kind": "msg",
   "ptrs": [
    "0x3BC4"
   ],
   "speaker": "ロセリニ",
   "jp": "　私は、この力の使い方を\n　彼らの意志に託すつもりです。\n\n",
   "en": ""
  },
  {
   "id": "ev131_1288",
   "kind": "msg",
   "ptrs": [
    "0x3BD8"
   ],
   "speaker": "ロセリニ",
   "jp": "　魔装機神の力は神の力に等しい。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_12B8",
   "kind": "msg",
   "ptrs": [
    "0x3BEC"
   ],
   "speaker": "ロセリニ",
   "jp": "　しかし、その力を\n　行使しているのは人間です。\n\n",
   "en": ""
  },
  {
   "id": "ev131_12F4",
   "kind": "msg",
   "ptrs": [
    "0x3C00"
   ],
   "speaker": "ロセリニ",
   "jp": "　私はこれからの未来を\n　国や権力といったものではなく\n　人間の良心に判断してもらいたい。\n",
   "en": ""
  },
  {
   "id": "ev131_1358",
   "kind": "msg",
   "ptrs": [
    "0x3C14"
   ],
   "speaker": "ロセリニ",
   "jp": "　そのためにも\n　彼らには彼らの判断のもと\n　行動させるつもりです。\n",
   "en": ""
  },
  {
   "id": "ev131_13A8",
   "kind": "msg",
   "ptrs": [
    "0x3C28"
   ],
   "speaker": "ロセリニ",
   "jp": "　分別のある人間には\n　現実を見ていない夢想家と\n　いわれるかもしれない。\n",
   "en": ""
  },
  {
   "id": "ev131_13FC",
   "kind": "msg",
   "ptrs": [
    "0x3C3C"
   ],
   "speaker": "ロセリニ",
   "jp": "　しかも彼らには\n　厳しい選択を強いることに\n　なるでしょう。\n",
   "en": ""
  },
  {
   "id": "ev131_1444",
   "kind": "msg",
   "ptrs": [
    "0x3C50"
   ],
   "speaker": "ロセリニ",
   "jp": "　しかし、私は\n　あの若者たちを信じたいのです。\n\n",
   "en": ""
  },
  {
   "id": "ev131_1480",
   "kind": "msg",
   "ptrs": [
    "0x3C64"
   ],
   "speaker": "ロセリニ",
   "jp": "　若者たちの真の力というものを。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_14B0",
   "kind": "msg",
   "ptrs": [
    "0x3C78"
   ],
   "speaker": "ロセリニ",
   "jp": "　願わくば\n　シャーナ様にも\n　ご理解をいただければ……。\n",
   "en": ""
  },
  {
   "id": "ev131_14F4",
   "kind": "msg",
   "ptrs": [
    "0x3C8C"
   ],
   "speaker": "ロセリニ",
   "jp": "　そう思っています。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1518",
   "kind": "msg",
   "ptrs": [
    "0x3CA0"
   ],
   "speaker": "シャーナ",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1538",
   "kind": "msg",
   "ptrs": [
    "0x3CB4"
   ],
   "speaker": "シャーナ",
   "jp": "　……夢想家。\n　確かにその通りかもしれませんね。\n\n",
   "en": ""
  },
  {
   "id": "ev131_1578",
   "kind": "msg",
   "ptrs": [
    "0x3CC8"
   ],
   "speaker": "シャーナ",
   "jp": "　ロセリニ様。\n　実は私もまったく同じことを　　\n　イェンに伝えてあります。\n",
   "en": ""
  },
  {
   "id": "ev131_15D0",
   "kind": "msg",
   "ptrs": [
    "0x3D04"
   ],
   "speaker": "シャーナ",
   "jp": "　そこにいるジェムスには\n　反対されましたけれど。\n\n",
   "en": ""
  },
  {
   "id": "ev131_1610",
   "kind": "msg",
   "ptrs": [
    "0x3D18"
   ],
   "speaker": "ジェムス",
   "jp": "　オ、オッホン……。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1634",
   "kind": "msg",
   "ptrs": [
    "0x3D2C"
   ],
   "speaker": "シャーナ",
   "jp": "　ですから\n　そのことについてもご心配なく。\n\n",
   "en": ""
  },
  {
   "id": "ev131_166C",
   "kind": "msg",
   "ptrs": [
    "0x3D68"
   ],
   "speaker": "シャーナ",
   "jp": "　私も彼らを信じております。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1698",
   "kind": "msg",
   "ptrs": [
    "0x3D7C"
   ],
   "speaker": "シャーナ",
   "jp": "　彼らが選ぶ道を。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_16B8",
   "kind": "msg",
   "ptrs": [
    "0x3D90"
   ],
   "speaker": "シャーナ",
   "jp": "　神ではなく\n　人が選ぶ未来を……。\n\n",
   "en": ""
  },
  {
   "id": "ev131_16E8",
   "kind": "msg",
   "ptrs": [
    "0x3DA4"
   ],
   "speaker": "ロセリニ",
   "jp": "　………………。　\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1708",
   "kind": "msg",
   "ptrs": [
    "0x3E44"
   ],
   "speaker": "",
   "jp": "　ラガーシュ王国　軍司令部\n　（旧バルツフィーム王国　王都）\n\n",
   "en": ""
  },
  {
   "id": "ev131_1748",
   "kind": "msg",
   "ptrs": [
    "0x3EF8"
   ],
   "speaker": "アデノイド",
   "jp": "　プラーナボム？\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1768",
   "kind": "msg",
   "ptrs": [
    "0x3F0C"
   ],
   "speaker": "アデノイド",
   "jp": "　ソッドが研究していた\n　爆弾のことか？\n\n",
   "en": ""
  },
  {
   "id": "ev131_17A0",
   "kind": "msg",
   "ptrs": [
    "0x3F48"
   ],
   "speaker": "ルジェロ",
   "jp": "　はい。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_17B8",
   "kind": "msg",
   "ptrs": [
    "0x3F84"
   ],
   "speaker": "ルジェロ",
   "jp": "　それの使用許可をいただきたいのです。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_17EC",
   "kind": "msg",
   "ptrs": [
    "0x3F98"
   ],
   "speaker": "アデノイド",
   "jp": "　ふむ……。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1808",
   "kind": "msg",
   "ptrs": [
    "0x3FAC"
   ],
   "speaker": "ルジェロ",
   "jp": "　プラーナボムを使えば\n　広大な範囲に壊滅的な打撃を\n　与えることができます。\n",
   "en": ""
  },
  {
   "id": "ev131_1860",
   "kind": "msg",
   "ptrs": [
    "0x3FC0"
   ],
   "speaker": "ルジェロ",
   "jp": "　これをやつらのいる場所の付近で\n　爆発させれば、魔装機神といえど……。\n\n",
   "en": ""
  },
  {
   "id": "ev131_18B4",
   "kind": "msg",
   "ptrs": [
    "0x3FD4"
   ],
   "speaker": "アデノイド",
   "jp": "　……倒せるということか。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_18E0",
   "kind": "msg",
   "ptrs": [
    "0x3FE8"
   ],
   "speaker": "ルジェロ",
   "jp": "　その通りです。\n\n\n",
   "en": ""
  },
  {
   "id": "ev131_1900",
   "kind": "msg",
   "ptrs": [
    "0x3FFC"
   ],
   "speaker": "ルジェロ",
   "jp": "　ただ、問題もあります。\n\n\n",
