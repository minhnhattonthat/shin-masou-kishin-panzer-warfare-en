 "lines": [
  {
   "id": "ev119_093C",
   "kind": "msg",
   "ptrs": [
    "0x3058"
   ],
   "speaker": "ラガーシュ兵士",
   "jp": "　マギーア様。\n　アデノイド様がお呼びです。\n\n",
   "en": ""
  },
  {
   "id": "ev119_097C",
   "kind": "msg",
   "ptrs": [
    "0x3094"
   ],
   "speaker": "マギーア",
   "jp": "　アデノイド様が？\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_099C",
   "kind": "msg",
   "ptrs": [
    "0x30D0"
   ],
   "speaker": "キャリ",
   "jp": "　命からがら帰ってきたっていうのに\n　呼び出しとは……。\n\n",
   "en": ""
  },
  {
   "id": "ev119_09E0",
   "kind": "msg",
   "ptrs": [
    "0x30E4"
   ],
   "speaker": "キャリ",
   "jp": "　人使いの荒い軍隊だね。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0A04",
   "kind": "msg",
   "ptrs": [
    "0x30F8"
   ],
   "speaker": "ラガーシュ兵士",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0A28",
   "kind": "msg",
   "ptrs": [
    "0x310C"
   ],
   "speaker": "マギーア",
   "jp": "　……わかった。\n　着替えたら、すぐにいく。\n\n",
   "en": ""
  },
  {
   "id": "ev119_0A60",
   "kind": "msg",
   "ptrs": [
    "0x3120"
   ],
   "speaker": "マギーア",
   "jp": "　それから\n　緊急の出撃があるかもしれん。\n　予備機を準備しておいてくれ。\n",
   "en": ""
  },
  {
   "id": "ev119_0AB4",
   "kind": "msg",
   "ptrs": [
    "0x3134"
   ],
   "speaker": "マギーア",
   "jp": "　それと出撃可能な魔装機に\n　出撃準備をさせておけ。\n\n",
   "en": ""
  },
  {
   "id": "ev119_0AF4",
   "kind": "msg",
   "ptrs": [
    "0x3148"
   ],
   "speaker": "ラガーシュ兵士",
   "jp": "　かしこまりました。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0B1C",
   "kind": "msg",
   "ptrs": [
    "0x315C"
   ],
   "speaker": "キャリ",
   "jp": "　出撃があるというのかい！？\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0B44",
   "kind": "msg",
   "ptrs": [
    "0x3170"
   ],
   "speaker": "マギーア",
   "jp": "　おそらくな。\n　でなければ、アデノイド様から\n　呼び出されることはないだろう。\n",
   "en": ""
  },
  {
   "id": "ev119_0BA0",
   "kind": "msg",
   "ptrs": [
    "0x3184"
   ],
   "speaker": "キャリ",
   "jp": "　でも、帰ってきたばかりだろう。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0BCC",
   "kind": "msg",
   "ptrs": [
    "0x3198"
   ],
   "speaker": "キャリ",
   "jp": "　すぐに出撃なんて無茶だ。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0BF4",
   "kind": "msg",
   "ptrs": [
    "0x31AC"
   ],
   "speaker": "キャリ",
   "jp": "　だいたい、\n　なぜそこまでして戦う。\n\n",
   "en": ""
  },
  {
   "id": "ev119_0C24",
   "kind": "msg",
   "ptrs": [
    "0x31C0"
   ],
   "speaker": "マギーア",
   "jp": "　なぜ？\n　おまえらしくない質問だな。\n\n",
   "en": ""
  },
  {
   "id": "ev119_0C58",
   "kind": "msg",
   "ptrs": [
    "0x31D4"
   ],
   "speaker": "キャリ",
   "jp": "　まさか、そこらの兵士と一緒で、\n　愛国心とか忠誠心とか\n　いうんじゃないだろうね。\n",
   "en": ""
  },
  {
   "id": "ev119_0CB4",
   "kind": "msg",
   "ptrs": [
    "0x31E8"
   ],
   "speaker": "キャリ",
   "jp": "　そんなんじゃ\n　生き残れないよ。\n\n",
   "en": ""
  },
  {
   "id": "ev119_0CE0",
   "kind": "msg",
   "ptrs": [
    "0x3224"
   ],
   "speaker": "マギーア",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0D00",
   "kind": "msg",
   "ptrs": [
    "0x3238"
   ],
   "speaker": "キャリ",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0D1C",
   "kind": "msg",
   "ptrs": [
    "0x3274"
   ],
   "speaker": "マギーア",
   "jp": "　戦うべき理由か……。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0D40",
   "kind": "msg",
   "ptrs": [
    "0x3288"
   ],
   "speaker": "マギーア",
   "jp": "　今度、考えておこう。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0D64",
   "kind": "msg",
   "ptrs": [
    "0x32B0"
   ],
   "speaker": "キャリ",
   "jp": "　ちょ、ちょっと待ちなって。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0D8C",
   "kind": "msg",
   "ptrs": [
    "0x32C4"
   ],
   "speaker": "マギーア",
   "jp": "　キャリ。\n　おまえは無理をしなくていい。\n\n",
   "en": ""
  },
  {
   "id": "ev119_0DC4",
   "kind": "msg",
   "ptrs": [
    "0x32D8"
   ],
   "speaker": "マギーア",
   "jp": "　死なれては\n　あとあと困るからな。\n\n",
   "en": ""
  },
  {
   "id": "ev119_0DF4",
   "kind": "msg",
   "ptrs": [
    "0x32EC"
   ],
   "speaker": "キャリ",
   "jp": "　マギーア……。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0E10",
   "kind": "msg",
   "ptrs": [
    "0x3300"
   ],
   "speaker": "キャリ",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0E2C",
   "kind": "msg",
   "ptrs": [
    "0x3314"
   ],
   "speaker": "キャリ",
   "jp": "　……たくっ。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0E48",
   "kind": "msg",
   "ptrs": [
    "0x3328"
   ],
   "speaker": "キャリ",
   "jp": "　整備兵！\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0E60",
   "kind": "msg",
   "ptrs": [
    "0x333C"
   ],
   "speaker": "キャリ",
   "jp": "　あたしの機体も\n　準備しておいてくれ！　\n\n",
   "en": ""
  },
  {
   "id": "ev119_0E94",
   "kind": "msg",
   "ptrs": [
    "0x3350"
   ],
   "speaker": "キャリ",
   "jp": "（あんたこそ\n　死なれちゃ困るんだよ……）\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0EC8",
   "kind": "msg",
   "ptrs": [
    "0x3418"
   ],
   "speaker": "アデノイド",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0EE8",
   "kind": "msg",
   "ptrs": [
    "0x3454"
   ],
   "speaker": "マギーア",
   "jp": "　お待たせいたしました。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0F10",
   "kind": "msg",
   "ptrs": [
    "0x3468"
   ],
   "speaker": "アデノイド",
   "jp": "　マギーアよ。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0F30",
   "kind": "msg",
   "ptrs": [
    "0x347C"
   ],
   "speaker": "アデノイド",
   "jp": "　ソッドのヤツを知らんか？\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0F5C",
   "kind": "msg",
   "ptrs": [
    "0x3490"
   ],
   "speaker": "マギーア",
   "jp": "　まだ、戻られていないのですか？\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_0F8C",
   "kind": "msg",
   "ptrs": [
    "0x34A4"
   ],
   "speaker": "マギーア",
   "jp": "　我々の出撃前に\n　魔装機で出かけられたのですが。\n\n",
   "en": ""
  },
  {
   "id": "ev119_0FCC",
   "kind": "msg",
   "ptrs": [
    "0x34B8"
   ],
   "speaker": "アデノイド",
   "jp": "　出かけた？\n　どこに……。\n\n",
   "en": ""
  },
  {
   "id": "ev119_0FF8",
   "kind": "msg",
   "ptrs": [
    "0x34CC"
   ],
   "speaker": "マギーア",
   "jp": "　お一人で出かけられたので\n　どこにいったのかはわかりません。\n\n",
   "en": ""
  },
  {
   "id": "ev119_1044",
   "kind": "msg",
   "ptrs": [
    "0x34E0"
   ],
   "speaker": "アデノイド",
   "jp": "　ちっ、この肝心なときに……。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1074",
   "kind": "msg",
   "ptrs": [
    "0x34F4"
   ],
   "speaker": "アデノイド",
   "jp": "　もういい。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1090",
   "kind": "msg",
   "ptrs": [
    "0x3508"
   ],
   "speaker": "アデノイド",
   "jp": "　なんにせよ、\n　ソッドを軍指令の立場から解任し、\n　これからは私が指示を出す。\n",
   "en": ""
  },
  {
   "id": "ev119_10EC",
   "kind": "msg",
   "ptrs": [
    "0x351C"
   ],
   "speaker": "アデノイド",
   "jp": "　それで\n　おまえを呼んだのは別の件だ。\n\n",
   "en": ""
  },
  {
   "id": "ev119_1124",
   "kind": "msg",
   "ptrs": [
    "0x3530"
   ],
   "speaker": "マギーア",
   "jp": "　別の件と申しますと？\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1148",
   "kind": "msg",
   "ptrs": [
    "0x3544"
   ],
   "speaker": "アデノイド",
   "jp": "　魔装機神はどうなった？\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1170",
   "kind": "msg",
   "ptrs": [
    "0x3558"
   ],
   "speaker": "マギーア",
   "jp": "　はい。\n　残念ながら……。\n\n",
   "en": ""
  },
  {
   "id": "ev119_1198",
   "kind": "msg",
   "ptrs": [
    "0x356C"
   ],
   "speaker": "アデノイド",
   "jp": "　失敗したということか。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_11C0",
   "kind": "msg",
   "ptrs": [
    "0x3580"
   ],
   "speaker": "マギーア",
   "jp": "　ヤツらの拠点の特定までは\n　できました。\n\n",
   "en": ""
  },
  {
   "id": "ev119_11F8",
   "kind": "msg",
   "ptrs": [
    "0x3594"
   ],
   "speaker": "マギーア",
   "jp": "　ただ。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1210",
   "kind": "msg",
   "ptrs": [
    "0x35A8"
   ],
   "speaker": "アデノイド",
   "jp": "　ただ？\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1228",
   "kind": "msg",
   "ptrs": [
    "0x35BC"
   ],
   "speaker": "マギーア",
   "jp": "　あのように、\n　部隊を各個投入していては\n　勝てるものも勝てなくなります。\n",
   "en": ""
  },
  {
   "id": "ev119_1280",
   "kind": "msg",
   "ptrs": [
    "0x35D0"
   ],
   "speaker": "マギーア",
   "jp": "　それにヤツらの拠点も\n　かなり強化されています。\n\n",
   "en": ""
  },
  {
   "id": "ev119_12C0",
   "kind": "msg",
   "ptrs": [
    "0x35E4"
   ],
   "speaker": "マギーア",
   "jp": "　直接攻撃を行うのであれば、\n　かなりの大部隊を動員しないと\n　勝てないでしょう。\n",
   "en": ""
  },
  {
   "id": "ev119_131C",
   "kind": "msg",
   "ptrs": [
    "0x35F8"
   ],
   "speaker": "アデノイド",
   "jp": "　おまえは、\n　私の指示が間違っていたというのか。\n\n",
   "en": ""
  },
  {
   "id": "ev119_135C",
   "kind": "msg",
   "ptrs": [
    "0x360C"
   ],
   "speaker": "マギーア",
   "jp": "　はい。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1374",
   "kind": "msg",
   "ptrs": [
    "0x3620"
   ],
   "speaker": "アデノイド",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1394",
   "kind": "msg",
   "ptrs": [
    "0x3634"
   ],
   "speaker": "マギーア",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_13B4",
   "kind": "msg",
   "ptrs": [
    "0x3648"
   ],
   "speaker": "アデノイド",
   "jp": "　ずいぶんハッキリいうな。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_13E0",
   "kind": "msg",
   "ptrs": [
    "0x365C"
   ],
   "speaker": "マギーア",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1400",
   "kind": "msg",
   "ptrs": [
    "0x3670"
   ],
   "speaker": "アデノイド",
   "jp": "　いいだろう。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1420",
   "kind": "msg",
   "ptrs": [
    "0x3684"
   ],
   "speaker": "アデノイド",
   "jp": "　わかった。\n　今回の件とともに不問としておこう。\n\n",
   "en": ""
  },
  {
   "id": "ev119_1460",
   "kind": "msg",
   "ptrs": [
    "0x3698"
   ],
   "speaker": "マギーア",
   "jp": "　ありがとうございます。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1488",
   "kind": "msg",
   "ptrs": [
    "0x36AC"
   ],
   "speaker": "アデノイド",
   "jp": "　それよりマギーアよ。\n　アルタドムスの神殿は知っておるな。\n\n",
   "en": ""
  },
  {
   "id": "ev119_14D4",
   "kind": "msg",
   "ptrs": [
    "0x36C0"
   ],
   "speaker": "マギーア",
   "jp": "　捕虜を収容している神殿のことですか？\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1508",
   "kind": "msg",
   "ptrs": [
    "0x36D4"
   ],
   "speaker": "アデノイド",
   "jp": "　そうだ。\n　そこで今、暴動が起きている。\n\n",
   "en": ""
  },
  {
   "id": "ev119_1540",
   "kind": "msg",
   "ptrs": [
    "0x36E8"
   ],
   "speaker": "アデノイド",
   "jp": "　それを鎮圧しろ。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1564",
   "kind": "msg",
   "ptrs": [
    "0x36FC"
   ],
   "speaker": "アデノイド",
   "jp": "　あそこには\n　バルツフィームの主要人物も\n　捕らえてある。\n",
   "en": ""
  },
  {
   "id": "ev119_15AC",
   "kind": "msg",
   "ptrs": [
    "0x3710"
   ],
   "speaker": "アデノイド",
   "jp": "　そいつらを救出され\n　ゲリラどもに勢いづかれてはかなわん。\n\n",
   "en": ""
  },
  {
   "id": "ev119_15F8",
   "kind": "msg",
   "ptrs": [
    "0x3724"
   ],
   "speaker": "アデノイド",
   "jp": "　なんなら、全員殺してもかまわん。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_162C",
   "kind": "msg",
   "ptrs": [
    "0x3738"
   ],
   "speaker": "アデノイド",
   "jp": "　見せしめだ。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_164C",
   "kind": "msg",
   "ptrs": [
    "0x374C"
   ],
   "speaker": "マギーア",
   "jp": "　かしこまりました。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1670",
   "kind": "msg",
   "ptrs": [
    "0x3760"
   ],
   "speaker": "マギーア",
   "jp": "　部隊の出撃準備が整いしだい\n　出撃します。\n\n",
   "en": ""
  },
  {
   "id": "ev119_16A8",
   "kind": "msg",
   "ptrs": [
    "0x3774"
   ],
   "speaker": "アデノイド",
   "jp": "　頼んだぞ。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_16C4",
   "kind": "msg",
   "ptrs": [
    "0x3788"
   ],
   "speaker": "マギーア",
   "jp": "　……はい。\n\n",
   "en": ""
  },
  {
   "id": "ev119_16DC",
   "kind": "msg",
   "ptrs": [
    "0x3850"
   ],
   "speaker": "ゲリラ兵",
   "jp": "　ロセリニ様。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_16F8",
   "kind": "msg",
   "ptrs": [
    "0x388C"
   ],
   "speaker": "ロセリニ",
   "jp": "　どうした……。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_1718",
   "kind": "msg",
   "ptrs": [
    "0x38A0"
   ],
   "speaker": "ゲリラ兵",
   "jp": "　どうやら、\n　バルツフィーム解放軍と\n　接触できたようです。\n",
   "en": ""
  },
  {
   "id": "ev119_1760",
   "kind": "msg",
   "ptrs": [
    "0x38B4"
   ],
   "speaker": "ゲリラ兵",
   "jp": "　我々の救出に\n　魔装機部隊が向かっているとの\n　連絡が入りました。\n",
   "en": ""
  },
  {
   "id": "ev119_17B0",
   "kind": "msg",
   "ptrs": [
    "0x38C8"
   ],
   "speaker": "ロセリニ",
   "jp": "　そうか。\n\n\n",
   "en": ""
  },
  {
   "id": "ev119_17C8",
