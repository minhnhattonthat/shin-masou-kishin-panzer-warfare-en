  },
  {
   "id": "ev16B_1488",
   "kind": "msg",
   "ptrs": [
    "0x4530"
   ],
   "speaker": "キャリ",
   "jp": "　愛国心とか忠誠心とか\n　いうんじゃないだろうね。\n\n",
