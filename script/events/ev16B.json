   ],
   "speaker": "アルマ",
   "jp": "　………………。\n\n\n",
   "en": ""
  },
  {
   "id": "ev16B_119C",
   "kind": "msg",
   "ptrs": [
    "0x40F8"
   ],
   "speaker": "ケイゴ",
   "jp": "　もうっ！！\n\n\n",
   "en": ""
  },
