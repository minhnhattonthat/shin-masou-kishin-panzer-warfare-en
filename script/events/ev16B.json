  },
  {
   "id": "ev16B_1424",
   "kind": "msg",
   "ptrs": [
    "0x44A4"
   ],
   "speaker": "キャリ",
   "jp": "　まあ、よろしく頼むよ。\n\n\n",
   "en": ""
  },
  {
   "id": "ev16B_1448",
   "kind": "msg",
   "ptrs": [
    "0x451C"
   ],
   "speaker": "キャリ",
   "jp": "　あんたは、いったいなんのために\n　戦っているんだい。\n\n",
