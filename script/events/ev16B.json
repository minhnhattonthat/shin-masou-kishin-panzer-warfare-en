  },
  {
   "id": "ev16B_0F54",
   "kind": "msg",
   "ptrs": [
    "0x4008"
   ],
   "speaker": "ケイゴ",
   "jp": "　へっ……！？\n\n\n",
   "en": ""
  },
  {
   "id": "ev16B_0F70",
   "kind": "msg",
   "ptrs": [
    "0x401C"
   ],
   "speaker": "ベウマー",
