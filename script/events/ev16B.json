  },
  {
   "id": "ev16B_10AC",
   "kind": "msg",
   "ptrs": [
    "0x4080"
   ],
   "speaker": "ケイゴ",
   "jp": "　トト！\n　おまえっ！！\n\n",
   "en": ""
  },
  {
   "id": "ev16B_10D0",
   "kind": "msg",
   "ptrs": [
    "0x4094"
   ],
   "speaker": "シェス",
